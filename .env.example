# ==============================================================================
# TerraTrust AI — Master Environment Configuration Template (.env.example)
# Climate-Aware Agricultural Credit Risk Assessment System (FIN-03)
# ==============================================================================

# Backend Service Configuration
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL Connection (Default local docker/native credentials)
DATABASE_URL=postgresql+psycopg://fin03:fin03_local_only@localhost:5432/fin03

# JWT & Authentication
JWT_SECRET_KEY=terratrust_local_jwt_secret_key_change_in_production_min32chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Machine Learning Artifacts
MODEL_PATH=models/terratust_crop_yield_model.pkl
CY_BENCH_BENCHMARK_PATH=docs/cy_bench_audit_report.json

# External Data Integrations (Leave blank for honest unavailable/mock-free fallback)
IMD_WEATHER_API_KEY=
COPERNICUS_SENTINEL_CLIENT_ID=
COPERNICUS_SENTINEL_CLIENT_SECRET=
NASA_EARTHDATA_TOKEN=
AGMARKNET_PRICE_API_KEY=

# Application Logging & Telemetry
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=15
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ENABLE_MOCKS=false
