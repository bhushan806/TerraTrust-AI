  "harmonization_verdict": {
    "can_concatenate_with_kaggle": false,
    "justification": "Kaggle dataset uses soil nutrient inputs (N, P, K) with synthetic units and no geo-coordinates. CY-Bench provides multi-spectral remote sensing (Sentinel-2 NDVI/EVI) and meteorological time-series. Blind concatenation introduces feature leakage and target mismatch. Models must remain separate services routed by available telemetry tier.",
    "recommended_routing": "Tier 1: Kaggle ExtraTrees (Soil NPK). Tier 2: CY-Bench ExtraTrees (Remote Sensing + Climate)."
  },
