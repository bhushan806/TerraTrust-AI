{
  "name": "terratrust-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Climate-Aware Agricultural Credit Decision-Support System",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "test": "npm run test --workspace=web",
    "generate:types": "npx openapi-typescript openapi.yaml -o apps/web/src/types/generated/openapi.ts",
    "validate:contract": "python scripts/count_endpoints.py"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.0"
  }
}
